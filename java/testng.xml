<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  API test suite.
  - Registers RetryListener so every @Test gets transient-only retry.
  - preserve-order="false" + parallel-friendly: tests must be independent.
-->
<suite name="ApiAutomationSuite" verbose="1">

    <listeners>
        <listener class-name="com.example.retry.RetryListener"/>
    </listeners>

    <test name="UsersApi" preserve-order="false">
        <classes>
            <class name="com.example.api.UsersApiTest"/>
        </classes>
    </test>

</suite>
